# OAuth client (Desktop app type) downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRETS_FILE=data/client_secret.json

# Where OAuth tokens are stored after running `gcal-sync auth`. Must not be committed.
TOKEN_DIR=data

# SQLite database used to persist sync tokens and event mappings.
DB_PATH=data/state.sqlite3

# Calendars to keep in sync: comma-separated '<account>:<calendar_id>' pairs.
# Every account name here needs its own `gcal-sync auth --account <name>` run first.
# At least 2 entries are required; any number (3+) is supported — every calendar is
# kept in sync with every other calendar listed here. Discover calendar IDs with:
#   gcal-sync calendars --account <name>
# Example with 3 calendars:
#   CALENDARS=workspace:you@company.com,personal:you@gmail.com,team:abc123@group.calendar.google.com
CALENDARS=

# Polling interval for the continuous service (`gcal-sync start`), in seconds.
POLL_INTERVAL_SECONDS=120

# How often (in hours) to force a full resync as a safety net against drift
# (e.g. a manually-edited mirror event, or a source event missed while offline).
FULL_RESYNC_INTERVAL_HOURS=24

# How many days ahead of now to keep in sync. Only events starting or ending
# within [now, now + SYNC_WINDOW_DAYS] are mirrored; older/far-future events
# are left alone. Events that later fall behind the window are not deleted —
# only cancelled/no-longer-blocking source events remove their mirror.
SYNC_WINDOW_DAYS=14

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Web sign-up (optional) ---------------------------------------------
# Only needed if you're running `gcal-sync web` to let other people connect their own
# calendars self-serve. Not required for the CLI-only / single-operator setup above.
# See README "Web sign-up for a team" for the full walkthrough.

# OAuth client (Web application type — NOT the Desktop client above) downloaded from
# Google Cloud Console. Its redirect URI must be exactly '<WEB_BASE_URL>/oauth/callback'.
GOOGLE_WEB_CLIENT_SECRETS_FILE=data/web_client_secret.json

# Public base URL this app is served at, no trailing slash, e.g. https://gcal.yourdomain.com
WEB_BASE_URL=

# Signs Flask's session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=

# Encrypts web-connected users' OAuth tokens at rest in the SQLite DB. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes all stored web-connected credentials unrecoverable — back it up
# alongside your other secrets, separately from data/state.sqlite3.
TOKEN_ENCRYPTION_KEY=

# Optional: restrict new sign-ups to Google Workspace accounts on this domain, e.g.
# "company.com" (no leading '@'). Only enforced when creating a brand-new account — an
# existing user can still connect an additional non-domain calendar (e.g. personal Gmail)
# afterwards. Leave blank to allow any Google account to sign up.
ALLOWED_DOMAIN=
